{
  "info": {
    "name": "Orwickle Core Dealroom API",
    "_postman_id": "4ab9b8d5-f6ea-4f8e-9ac9-2b507c3d67c9",
    "description": "Production REST API collection for Orwickle — The FYP Dealroom Dossier Marketplace.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "loginTicket",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Infrastructure & Health",
      "item": [
        {
          "name": "Liveness Probe",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:4000/health/live"
            }
          }
        },
        {
          "name": "Readiness Probe",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:4000/health/ready"
            }
          }
        },
        {
          "name": "Detailed Cluster Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health"
            }
          }
        }
      ]
    },
    {
      "name": "2. Core Authentication",
      "item": [
        {
          "name": "User Signup",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/signup"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"founder@szabist.pk\",\n  \"password\": \"SecureFounderPassword2026!\",\n  \"full_name\": \"Mustafa Muhammad\",\n  \"role\": \"student\"\n}"
            }
          }
        },
        {
          "name": "Verify Email (Anti-Pre-Hijacking)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/verify-email"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"founder@szabist.pk\",\n  \"otp\": \"123456\",\n  \"password\": \"SecureFounderPassword2026!\"\n}"
            }
          }
        },
        {
          "name": "Resend Verification Code",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/resend-verification"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"founder@szabist.pk\"\n}"
            }
          }
        },
        {
          "name": "Password Login (MFA Challenge)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/login"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"founder@szabist.pk\",\n  \"password\": \"SecureFounderPassword2026!\",\n  \"device_label\": \"MacBook Pro 16 M3\"\n}"
            }
          }
        },
        {
          "name": "Verify Login OTP (Token Pair)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/login/verify-otp"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login_ticket\": \"{{loginTicket}}\",\n  \"otp\": \"123456\",\n  \"device_label\": \"MacBook Pro 16 M3\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token Rotation",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/refresh"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Logout Current Session",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/logout"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        },
        {
          "name": "Logout All Active Sessions",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/logout-all"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        },
        {
          "name": "Forgot Password Request",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"founder@szabist.pk\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"raw_reset_token_from_email\",\n  \"new_password\": \"NewSecureFounderPassword2026!\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. User Profile & Sessions",
      "item": [
        {
          "name": "Get Current Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/me"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/me/profile"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"display_name\": \"Mustafa M.\",\n  \"bio\": \"Chief Architect & Dealroom Founder\"\n}"
            }
          }
        },
        {
          "name": "List User Active Sessions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/me/sessions"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        },
        {
          "name": "Revoke User Session",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/me/sessions/session-uuid-here"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "4. Administrative Management",
      "item": [
        {
          "name": "System Statistics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/stats"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Orwickle-Admin",
                "value": "1"
              }
            ]
          }
        },
        {
          "name": "List Users (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/users?limit=20&page=1"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Orwickle-Admin",
                "value": "1"
              }
            ]
          }
        },
        {
          "name": "Update User Status (Suspend/Activate)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/admin/users/user-uuid-here/status"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Orwickle-Admin",
                "value": "1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"suspended\"\n}"
            }
          }
        },
        {
          "name": "List All Platform Sessions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/sessions"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Orwickle-Admin",
                "value": "1"
              }
            ]
          }
        },
        {
          "name": "Revoke Session (Admin Override)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/admin/sessions/session-uuid-here"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Orwickle-Admin",
                "value": "1"
              }
            ]
          }
        },
        {
          "name": "Audit Log Ledger Viewer",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/audit?limit=50&page=1"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Orwickle-Admin",
                "value": "1"
              }
            ]
          }
        }
      ]
    }
  ]
}
