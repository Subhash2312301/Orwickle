# Auto-normalize line endings to LF across Linux and Windows
* text=auto eol=lf

# Explicit text files
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.html text eol=lf
*.css text eol=lf
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.gitignore text eol=lf
.env* text eol=lf
