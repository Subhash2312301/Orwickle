# ==============================================================================
# Orwickle Core Backend Environment Configuration (v1.2)
# ==============================================================================

# Application Environment & Server Port
NODE_ENV=development
PORT=4000

# PostgreSQL Database Connection Strings
# APP: Uses the Supabase Transaction Pooler (port 6543)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orwickle
# MIGRATIONS: Uses the Supabase Session Pooler (port 5432) or direct connection (DDL requires session state)
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5432/orwickle
# TESTS: Isolated real PostgreSQL test database
DATABASE_TEST_URL=postgres://postgres:postgres@localhost:5432/orwickle_test

# SSL Configuration (Use official Supabase CA root certificate; rejectUnauthorized: false is eliminated)
DATABASE_SSL=false
DATABASE_CA_CERT=

# Cryptographic Secrets
JWT_SECRET=orwickle_jwt_access_secret_minimum_32_characters_key_2026
PASSWORD_RESET_SECRET=orwickle_password_reset_secret_minimum_32_characters_key_2026
OTP_PEPPER=orwickle_otp_pepper_secret_minimum_32_characters_key_2026

# Email Delivery Configuration
# Options: 'console' (prints OTPs and notices to terminal) or 'smtp' (live mail delivery)
# INVARIANT: If NODE_ENV=production, MAIL_MODE MUST be 'smtp'.
MAIL_MODE=console

# SMTP Settings (Required if MAIL_MODE=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@orwickle.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Orwickle Dealroom <no-reply@orwickle.com>"

# CORS and Security Configurations
ADMIN_CORS_ORIGIN=http://localhost:5173
MOBILE_ALLOWED_ORIGINS=http://localhost,capacitor://localhost

# Authentication Security Policies
LOGIN_OTP_MODE=always
MAX_OTP_ATTEMPTS=5
ACCOUNT_LOCKOUT_THRESHOLD=5
REFRESH_TOKEN_GRACE_SECONDS=10
