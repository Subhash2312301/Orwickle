# ==============================================================================
# Orwickle Core Backend Environment Configuration
# ==============================================================================

# Application Environment & Server Port
NODE_ENV=development
PORT=4000

# PostgreSQL Database Connection Strings (Supabase Pooler / Direct Postgres)
# In production, use the Supabase Transaction Pooler URL (port 6543) or Session Pooler (port 5432) with SSL.
# Example: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orwickle
DATABASE_TEST_URL=postgres://postgres:postgres@localhost:5432/orwickle_test
DATABASE_SSL=true

# Authentication Tokens & Cryptographic Salts
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=orwickle_jwt_access_secret_minimum_32_characters_key_2026
JWT_REFRESH_SECRET=orwickle_jwt_refresh_secret_minimum_32_characters_key_2026
OTP_PEPPER=orwickle_otp_pepper_secret_minimum_32_characters_key_2026

# Email Delivery Configuration
# Options: 'console' (prints OTPs and notices to terminal) or 'smtp' (live mail delivery)
# INVARIANT: If NODE_ENV=production, MAIL_MODE MUST be 'smtp'. If set to 'console', the server throws at startup.
MAIL_MODE=console

# SMTP Settings (Required if MAIL_MODE=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@orwickle.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Orwickle Dealroom <no-reply@orwickle.com>"

# CORS and Security Configurations
ADMIN_CORS_ORIGIN=http://localhost:5173
MOBILE_ALLOWED_ORIGINS=http://localhost,capacitor://localhost

# Authentication Security Policies
REQUIRE_LOGIN_OTP=false
MAX_OTP_ATTEMPTS=5
ACCOUNT_LOCKOUT_THRESHOLD=6
ACCOUNT_LOCKOUT_MINUTES=15
REFRESH_TOKEN_GRACE_SECONDS=10
